{
  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "pairing",
      groups: {
        "*": {
          requireMention: true
        }
      }
    }
  },
  security: {
    allowedOrigins: [
      "http://localhost:18789",
      "http://127.0.0.1:18789"
    ],
    sandbox: {
      enabled: true,
      mode: "isolated"
    }
  },
  gateway: {
    port: 18789,
    bind: "127.0.0.1"
  }
}
